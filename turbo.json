{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".cloudflare/output/**"]
    },
    "build:types": {
      "dependsOn": ["^build:types"],
      "outputs": ["dist/types/**"]
    },
    "typecheck": {
      "dependsOn": ["^build:types"]
    },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
