{
  "name": "@sake/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "types": "./dist/types/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts"
    }
  },
  "scripts": {
    "dev": "cf dev",
    "build": "cf build",
    "deploy": "cf deploy --mode production",
    "deploy:staging": "cf deploy --mode staging",
    "types": "cf workers types",
    "typecheck": "cf workers types && tsc",
    "build:types": "cf workers types && tsc -p tsconfig.build.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "cf d1 migrations apply 3f2c7a9e-8b1d-4c5e-9f0a-1b2c3d4e5f60 --local --persist-to ./.cloudflare/state --dir ./drizzle",
    "db:migrate:staging": "cf d1 migrations apply $STAGING_D1_ID --mode staging --dir ./drizzle",
    "db:migrate:production": "cf d1 migrations apply $PRODUCTION_D1_ID --mode production --dir ./drizzle",
    "logs": "wrangler tail sake-api",
    "logs:staging": "wrangler tail sake-api-staging"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@sake/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-8c6014f9a",
    "cf": "^1.0.0-beta.16",
    "drizzle-kit": "^0.31.11",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "wrangler": "^4.150.0"
  }
}
